    <Compile Include="../src/SBPR.Trailborne/Features/Portals/TwistedPortalLabelScale.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/Portals/PortalEnergyMath.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/Portals/AimPickMath.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/Portals/TwistedPortalPreviewText.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/Portals/TwistedDirectoryModel.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/SeersStone/SeersStoneEligibility.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/SeersStone/WhitelistDocument.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/SeersStone/WispMotion.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/SeersStone/SeersStonePinDecision.cs" />
    <Compile Include="../src/SBPR.Trailborne/Features/SeersStone/PickableClustering.cs" />
    <!-- Production Homestead assignment/seating domain logic is engine-free and link-compiled
         into this net8 test project while the shipping mod consumes the same source under net48. -->
