# ============================================================================
#  Niflheim 0003 — cold-reload harness controller manifest (EXAMPLE).
# ----------------------------------------------------------------------------
#  OPERATE stages a REAL manifest from this template once a disposable Astley
#  fixture + lease + rollback bytes exist. The controller sources it as shell
#  key=value. Every key below is REQUIRED; an empty/missing key is a refusal.
#
#  NEVER point any of these at a production Niflheim/Heistan world or port —
#  the controller AND the in-client arming gate both hard-refuse those names
#  (niflheim/heistan) and ports (2456/2457/2466/2467).
# ============================================================================

# OPERATE-issued exclusive runtime lease id for this QA window.
LEASE_ID="REPLACE_WITH_OPERATE_LEASE"

# Absolute path to the pre-run rollback bytes OPERATE captured (world backup).
ROLLBACK_BYTES="/absolute/path/to/astley-rollback.db"

# The disposable Astley world files to cold-load. UID MUST equal WORLD_UID below.
DISPOSABLE_DB="/absolute/path/to/Astley.db"
DISPOSABLE_FWL="/absolute/path/to/Astley.fwl"

# Exact source-fixed disposable fixture UID (must match 2413287143).
WORLD_UID="2413287143"

# The disposable world/target identity — must NOT contain niflheim/heistan.
TARGET_WORLD_NAME="astley-disposable-qa"
TARGET_PORT="2600"

# Where the in-client observer writes the PRE/POST captures.
CAPTURE_DIR="/absolute/path/to/evidence/niflheim-0003-reload"

# The command that launches the graphical Valheim client bound to the disposable
# world (OPERATE supplies the concrete Steam/GABS invocation). The controller
# exports NIFLHEIM_RELOAD_HARNESS_PHASE=PRE|POST and _CAPTURE_DIR for it.
VALHEIM_CLIENT_CMD="/absolute/path/to/launch-astley-client.sh"

# Optional: how to request a real world save on the running client (admin RPC /
# console command) and the file that proves it landed.
SAVE_TRIGGER_CMD=""
SAVE_RECEIPT_FILE="/absolute/path/to/evidence/niflheim-0003-reload/save-receipt.json"

# Build/artifact provenance hashes the in-client observer stamps onto every capture.
# PRE and POST MUST share these exactly (a drift means the two boots ran different
# bytes). All three are REQUIRED; an empty value is a refusal.
PROV_SOURCE_HASH="REPLACE_WITH_SOURCE_TREE_SHA256"
PROV_PRODUCT_HASH="REPLACE_WITH_PRODUCT_DLL_SHA256"
PROV_HARNESS_HASH="REPLACE_WITH_HARNESS_SHA256"

# Bounded arming waits (seconds) the in-client observer enforces. Finite + positive,
# each <= 900s; readiness retries in [0..1]. Defaults: readiness 300, phase 60, retries 1.
READINESS_WAIT_SECONDS="300"
PHASE_WAIT_SECONDS="60"
READINESS_RETRIES="1"

# Optional bounded-wait overrides (seconds) for the controller's own file waits.
# Defaults: readiness 300, save 120, exit 60.
READINESS_TIMEOUT="300"
SAVE_TIMEOUT="120"
EXIT_TIMEOUT="60"
